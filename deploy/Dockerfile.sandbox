FROM node:22-alpine

WORKDIR /app

# Create writable state directory for AME_STORAGE_MODE=file before switching to non-root user
RUN mkdir -p /data && chown -R node:node /app /data

COPY --chown=node:node package.json ./package.json
COPY --chown=node:node spec/openapi.yaml ./spec/openapi.yaml
COPY --chown=node:node packages/sdk-ts ./packages/sdk-ts
COPY --chown=node:node packages/sandbox-server ./packages/sandbox-server

USER node

ENV NODE_ENV=production
ENV AME_HOST=0.0.0.0
ENV AME_PORT=8090
ENV AME_STORAGE_MODE=file
ENV AME_STORAGE_PATH=/data/ame-sandbox-state.json

EXPOSE 8090

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.AME_PORT || 8090) + '/v1/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "packages/sandbox-server/bin/serve.mjs"]
