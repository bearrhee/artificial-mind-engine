# ==============================================================================
# Artificial Mind Engine (AME) — Sealed Kernel Deployment Environment
# ==============================================================================
# Copy this file to `deploy/.env` before starting Docker Compose:
#   cd deploy && cp .env.example .env && cd ..
#   docker compose -f deploy/docker-compose.sealed.yml --env-file deploy/.env up -d
#
# SECURITY NOTICE — NO LLM PROVIDER KEYS HERE:
#   Do NOT place OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY,
#   DEEPSEEK_API_KEY, OPENROUTER_API_KEY, or any other LLM provider credentials
#   in `deploy/.env`.
#   - Mode A (Proxy BYO-LLM: POST /v1/minds/{mindId}/turn):
#       Client applications pass `llm.apiKey` transiently per request; the
#       sealed kernel forwards the request without storing or logging the key.
#   - Mode B (Zero-Key Prepare/Settle: /prepare -> client LLM -> /settle):
#       LLM provider keys stay exclusively on the client side and never enter
#       the AME container boundary.
# ==============================================================================

# ------------------------------------------------------------------------------
# Sealed Kernel Container Image & Network Port
# ------------------------------------------------------------------------------
# Closed-IP proprietary kernel image (requires registry auth if private).
AME_SEALED_IMAGE=ghcr.io/bearrhee/ame-kernel-sealed:latest

# Host port mapped to container port 8090 (AME Gateway API).
AME_PORT=8090

# ------------------------------------------------------------------------------
# Gateway Authentication & Kernel License
# ------------------------------------------------------------------------------
# Shared API key expected by the gateway in the `X-AME-API-Key` request header.
# Replace with a high-entropy secret before deployment.
AME_API_KEY=change-me-ame-gateway-api-key

# Commercial or evaluation license key required by `AME_MODE=sealed-kernel`.
AME_LICENSE_KEY=change-me-ame-sealed-license-key

# Kernel log verbosity (e.g., error | warn | info | debug).
# Note: D4 redaction (`AME_D4_STRICT_REDACTION=true`) remains strictly enforced
# in docker-compose.sealed.yml regardless of log level.
AME_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# PostgreSQL (pgvector:pg17) Backing Store
# ------------------------------------------------------------------------------
# Used both to initialize the `postgres` container and to build `DATABASE_URL` /
# `AME_DATABASE_URL` inside `docker-compose.sealed.yml`.
# Tip: Use URL-safe characters (alphanumeric, `-`, `_`) for `POSTGRES_PASSWORD`
# because it is interpolated directly into PostgreSQL connection URIs.
POSTGRES_USER=ame
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=ame

# ------------------------------------------------------------------------------
# Optional Semantic RAG (pgvector HNSW + Dense Embeddings + Cross-Encoder Rerank)
# ------------------------------------------------------------------------------
# Standalone Sealed Kernel v4.3.0 automatically persists vector(1024) embeddings
# into PostgreSQL (initialized from deploy/init.sql) and enables paraphrase +
# assistant-reply semantic retrieval when an embedding/rerank key is supplied.
# Leave unset to run zero-external-call lexical/epoch recall.
# Notice: Zero-Key LLM boundary remains intact (LLM keys never enter here).
AME_SEMANTIC_RAG_ENABLED=1
# AME_EMBEDDING_PROVIDER=jina          # jina | openai | openai-compat | none
# AME_EMBEDDING_API_KEY=               # defaults to JINA_API_KEY when provider=jina
# AME_EMBEDDING_MODEL=jina-embeddings-v3
# AME_EMBEDDING_DIM=1024
# AME_EMBEDDING_BASE_URL=
# AME_RERANK_PROVIDER=jina             # jina | openrouter | none
# AME_RERANK_API_KEY=                  # defaults to JINA_API_KEY when provider=jina
# AME_RERANK_MODEL=jina-reranker-v2-base-multilingual
# AME_RERANK_BASE_URL=
# JINA_API_KEY=
